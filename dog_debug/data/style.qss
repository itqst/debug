/* iOS 浅色外观；@DATA 在加载时替换为本目录绝对路径 */
QMainWindow, QWidget#content {background:#F4F6FA}
QWidget {color:#1C1C1E}
QFrame#sidebar {background:#EFF2F7;border:0;border-right:1px solid #DEE5EF}
QLabel#appTitle {font-size:19px;font-weight:700}
QLabel#appSub, QLabel#caption {color:#8E8E93;font-size:12px}
QLabel#groupHeader {color:#8E8E93;font-size:11px;font-weight:600;padding-left:6px}
QLabel#largeTitle {font-size:28px;font-weight:700}
QLabel#sectionTitle {font-size:15px;font-weight:600}
QLabel#heading {font-size:21px;font-weight:700}

QListWidget#nav {background:transparent;border:0;outline:0}
/* 导航行由 NavDelegate 自己画（线形图标、白底选中块和蓝色短标记），这里只去掉默认底色 */
QListWidget#nav::item {background:transparent;border:0}

QFrame#card {background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #FFFFFF,stop:1 #FCFDFF);border:1px solid #DFE6F0;border-radius:14px}
QFrame#sideCard {background:white;border:1px solid #DFE6F0;border-radius:12px}
QFrame#step {background:#F7F7FA;border:1px solid transparent;border-radius:10px}
QFrame#step:hover {background:#F0F0F5}
QFrame#stepSelected {background:#EAF3FF;border:1px solid #9CC8FF;border-radius:10px}

/* 次要按钮白底细边，主按钮蓝色轻渐变，危险操作保留红色 */
QPushButton {background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #FFFFFF,stop:1 #F7F9FC);border:1px solid #D6DFEB;border-radius:9px;padding:5px 12px;color:#33496A;font-weight:600}
QPushButton:focus {border-color:#578EEF}
QPushButton:hover {background:#F2F6FD;border-color:#B5C8E6}
QPushButton:pressed {background:#E4ECF7;border-color:#A7BEDF}
QPushButton:disabled {color:#B0B0B5}
QPushButton#primary {background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #438BF3,stop:1 #2A70DE);border:1px solid #2F72D8;color:white;padding:6px 22px}
QPushButton#primary:focus {border-color:#1D57AF}
QPushButton#primary:hover {background:#367FEA}
QPushButton#primary:pressed {background:#2463C5;border-color:#1D57AF}
QPushButton#danger {background:#FFF3F1;border-color:#F0D6D1;color:#D34E42}
QPushButton#link {background:transparent;border:0;color:#007AFF;padding:4px 6px;font-weight:500}
QPushButton#link:hover {color:#0062CC}

QFrame#seg {background:#E3E3E8;border-radius:9px}
QPushButton#segBtn {background:transparent;border:0;color:#1C1C1E;border-radius:7px;padding:5px 12px;font-weight:500}
QPushButton#segBtn:hover {background:rgba(255,255,255,110)}
QPushButton#segBtn:checked {background:transparent;font-weight:600}
QFrame#segThumb {background:white;border-radius:7px;border:1px solid rgba(0,0,0,18)}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {background:#FBFCFE;border:1px solid #DCE4EF;border-radius:9px;padding:7px 10px;selection-background-color:#007AFF;selection-color:white}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {background:white;border:1px solid #548BEA}
QFrame#sidebar QLineEdit, QFrame#sidebar QSpinBox, QFrame#sidebar QComboBox {background:#FBFCFE}
QLineEdit#search {background:#FBFCFE;border:1px solid #DCE4EF;border-radius:10px;padding:8px 12px}
QLineEdit#search:focus {background:white}
QComboBox::drop-down {border:0;width:26px}
QComboBox::down-arrow {image:url(@DATA/chevron.svg);width:12px;height:12px}
QComboBox QAbstractItemView {background:white;border:1px solid #D1D1D6;border-radius:8px;padding:4px;outline:0;selection-background-color:#007AFF;selection-color:white}

QPlainTextEdit#code {background:#F7F7FA;border:1px solid #E5E5EA;border-radius:10px;padding:8px;font-family:'Cascadia Mono','Consolas','Menlo','DejaVu Sans Mono';font-size:13px;color:#1C1C1E}
QPlainTextEdit#code:focus {border:1px solid #007AFF;background:white}
QPlainTextEdit#plain, QTextBrowser {background:transparent;border:0}

QListWidget#commands {background:transparent;border:0;outline:0}
QListWidget#commands::item {padding:7px 10px;border-radius:8px;margin:0 2px}
QListWidget#commands::item:hover:!selected {background:#F2F2F7}
QListWidget#commands::item:selected {background:#007AFF;color:white}

QTableView, QTableWidget {background:white;border:0;gridline-color:transparent;outline:0;alternate-background-color:#FAFAFC;selection-background-color:#E5F1FF;selection-color:#1C1C1E}
QTableView::item, QTableWidget::item {padding:0 6px;border-bottom:1px solid #F0F0F3}
QTableView::item:hover, QTableWidget::item:hover {background:#F2F7FF}
QTableView::item:selected, QTableWidget::item:selected {background:#E5F1FF;color:#1C1C1E}
QHeaderView {background:white;border:0}
QHeaderView::section {background:white;color:#8E8E93;border:0;border-bottom:1px solid #E5E5EA;padding:8px 6px;font-size:12px;font-weight:600}
QTableCornerButton::section {background:white;border:0}

QScrollArea {background:transparent;border:0}
QScrollArea > QWidget > QWidget {background:transparent}
QScrollBar:vertical {background:transparent;width:10px;margin:3px 2px}
QScrollBar:horizontal {background:transparent;height:10px;margin:2px 3px}
QScrollBar::handle:vertical {background:rgba(0,0,0,55);border-radius:3px;min-height:32px}
QScrollBar::handle:horizontal {background:rgba(0,0,0,55);border-radius:3px;min-width:32px}
QScrollBar::handle:hover {background:rgba(0,0,0,90)}
QScrollBar::add-line, QScrollBar::sub-line {width:0;height:0}
QScrollBar::add-page, QScrollBar::sub-page {background:none}
QSplitter::handle {background:transparent}

QToolTip {background:#2C2C2E;color:white;border:0;border-radius:6px;padding:6px 8px}
QLabel#toast {background:rgba(28,28,30,232);color:white;border-radius:17px;padding:8px 20px;font-weight:500}
QDialog {background:#F2F2F7}

QPushButton#tile {background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #FFFFFF,stop:1 #F7F9FC);border:1px solid #D6DFEB;color:#1C1C1E;border-radius:12px;padding:12px 14px;font-weight:600}
QPushButton#tile:hover {background:#F2F6FD;border-color:#B5C8E6}
QPushButton#tile:pressed {background:#2A70DE;border-color:#2463C5;color:white}
QPushButton#pad {background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #FFFFFF,stop:1 #F7F9FC);border:1px solid #D6DFEB;color:#1C1C1E;border-radius:29px;font-size:20px;padding:0}
QPushButton#pad:hover {background:#F2F6FD;border-color:#B5C8E6}
QPushButton#pad:pressed {background:#2A70DE;border-color:#2463C5;color:white}
QPushButton#padStop {background:#FFF3F1;border:1px solid #F0D6D1;color:#D34E42;border-radius:29px;padding:0}
QPushButton#padStop:pressed {background:#D34E42;color:white}
QSlider::groove:horizontal {height:4px;background:#E1E1E6;border-radius:2px}
QSlider::sub-page:horizontal {background:#007AFF;border-radius:2px}
QSlider::handle:horizontal {background:white;border:1px solid #D1D1D6;width:22px;height:22px;margin:-9px 0;border-radius:11px}
QFrame#stat {background:#F5F5F8;border-radius:10px}
QLabel#statValue {font-size:16px;font-weight:700}
QLabel#deviceName {font-size:14px;font-weight:700}
QPushButton#chip {background:#E5F1FF;border:0;color:#007AFF;border-radius:13px;padding:4px 12px;font-weight:600}
QPushButton#chip:hover {background:#D6E8FF}
QProgressBar {background:#E5E5EA;border:0;border-radius:3px}
QProgressBar::chunk {background:#007AFF;border-radius:3px}
QFrame#noteCard {background:#FFF8E6;border:1px solid #FFE2A8;border-radius:12px}
QFrame#banner {background:#EEF5FF;border:1px solid #CFE2FF;border-radius:12px}
QFrame#banner[error="true"] {background:#FFF0EF;border:1px solid #FFD0CC}
QMenu {background:white;border:1px solid #D1D1D6;border-radius:10px;padding:6px}
QMenu::item {padding:7px 18px;border-radius:7px;color:#1C1C1E}
QMenu::item:selected {background:#007AFF;color:white}
QPushButton#primary::menu-indicator {image:none;width:0}
QLabel#detailBlock {background:#F7F7FA;border-radius:10px;padding:10px}
