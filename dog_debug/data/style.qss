/* iOS 浅色外观（按 tta_debug_studio_ios.html 的配色和圆角）；@DATA 在加载时替换为本目录绝对路径；深色版由 ui.dark_style 按色值替换生成 */
QMainWindow, QWidget#content, QWidget#shell {background:#F3F4F8}
QWidget {color:#1C1C1E}
QFrame#sidebar {background:#F9F9FB;border:0;border-right:1px solid #E6E7EC}
QFrame#topbar {background:#F9F9FB;border:0;border-bottom:1px solid #E6E7EC}
QLabel#appTitle {font-size:15px;font-weight:700}
QLabel#appSub, QLabel#caption {color:#8E8E93;font-size:12px}
QLabel#version {background:#E1EEFF;color:#007AFF;border-radius:5px;padding:0 5px;font-size:11px;font-weight:700}
QLabel#groupHeader {color:#8E8E93;font-size:11px;font-weight:600;padding-left:6px}
QLabel#largeTitle {font-size:26px;font-weight:700}
QLabel#sectionTitle {font-size:15px;font-weight:600}
QLabel#heading {font-size:21px;font-weight:700}
QLabel#kbd {background:#EAEAEF;color:#8E8E93;border:1px solid #E1E2E8;border-radius:5px;padding:0 5px;font-size:11px}

QListWidget#nav {background:transparent;border:0;outline:0}
/* 导航行由 NavDelegate 自己画（线形图标、选中的蓝色填充块和快捷键），这里只去掉默认底色 */
QListWidget#nav::item {background:transparent;border:0}

QFrame#card {background:white;border:1px solid #E7E8EE;border-radius:18px}
QFrame#sideCard {background:white;border:1px solid #E7E8EE;border-radius:14px}
QFrame#sheet {background:white;border:1px solid #E7E8EE;border-radius:20px}
QFrame#step {background:#F7F7FA;border:1px solid transparent;border-radius:12px}
QFrame#step:hover {background:#EFF0F5}
QFrame#stepSelected {background:#EAF3FF;border:1px solid #9CC8FF;border-radius:12px}
/* 顶部连接胶囊和最近指令胶囊 */
QFrame#pill {background:white;border:1px solid #E1E2E8;border-radius:16px}
QFrame#pill:hover {border-color:#7FB5FF}
QFrame#lockPill {background:#EAEAEF;border:1px solid #E1E2E8;border-radius:16px}

/* 次要按钮灰底细边，主按钮蓝色渐变，危险操作淡红 */
QPushButton {background:#EAEAEF;border:1px solid #E1E2E8;border-radius:11px;padding:6px 13px;color:#1C1C1E;font-weight:500}
QPushButton:focus {border-color:#7FB5FF}
QPushButton:hover {background:#E5F0FF;border-color:#B8D6FF;color:#007AFF}
QPushButton:pressed {background:#D6E8FF;border-color:#99C5FF}
QPushButton:disabled {color:#B0B0B5;background:#EFEFF3}
QPushButton#primary {background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #1A88FF,stop:1 #007AFF);border:1px solid #0A6FE0;color:white;padding:6px 20px;font-weight:600}
QPushButton#primary:focus {border-color:#005BC2}
QPushButton#primary:hover {background:#2A90FF;color:white}
QPushButton#primary:pressed {background:#0068D6;border-color:#005BC2}
QPushButton#primary:disabled {background:#A8CCF5;border-color:#A8CCF5;color:white}
QPushButton#danger {background:#FFE9E8;border-color:#FFD0CC;color:#FF3B30}
QPushButton#danger:hover {background:#FFDAD7;color:#FF3B30}
QPushButton#link {background:transparent;border:0;color:#007AFF;padding:4px 6px;font-weight:500}
QPushButton#link:hover {color:#0062CC;background:transparent}
QPushButton#icon {background:#EAEAEF;border:1px solid #E1E2E8;border-radius:11px;padding:5px 9px;font-size:15px}

QFrame#seg {background:#EAEAEF;border:1px solid #E1E2E8;border-radius:11px}
QPushButton#segBtn {background:transparent;border:0;color:#545458;border-radius:8px;padding:5px 12px;font-weight:500}
QPushButton#segBtn:hover {background:transparent;color:#1C1C1E}
QPushButton#segBtn:checked {background:transparent;color:#1C1C1E;font-weight:600}
QPushButton#segBtn:disabled {color:#B0B0B5}
QFrame#segThumb {background:white;border-radius:8px;border:1px solid #DCDDE3}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {background:#F2F2F5;border:1px solid #E6E7EC;border-radius:10px;padding:7px 10px;selection-background-color:#007AFF;selection-color:white}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {background:white;border:1px solid #7FB5FF}
QLineEdit:disabled, QComboBox:disabled {color:#8E8E93}
QLineEdit#search {background:#F2F2F5;border:1px solid #E6E7EC;border-radius:11px;padding:8px 12px}
QLineEdit#search:focus {background:white}
QComboBox::drop-down {border:0;width:26px}
QComboBox::down-arrow {image:url(@DATA/chevron.svg);width:12px;height:12px}
QComboBox QAbstractItemView {background:white;border:1px solid #E1E2E8;border-radius:10px;padding:4px;outline:0;selection-background-color:#007AFF;selection-color:white}

QPlainTextEdit#code {background:#F7F7FA;border:1px solid #E6E7EC;border-radius:12px;padding:8px;font-family:'Cascadia Mono','JetBrains Mono','Consolas','Menlo','DejaVu Sans Mono';font-size:13px;color:#1C1C1E}
QPlainTextEdit#code:focus {border:1px solid #7FB5FF;background:white}
QPlainTextEdit#plain, QTextBrowser {background:transparent;border:0}

QListWidget#commands {background:transparent;border:0;outline:0}
QListWidget#commands::item {padding:8px 10px;border-radius:12px;margin:1px 2px}
QListWidget#commands::item:hover:!selected {background:#F2F2F5}
QListWidget#commands::item:selected {background:#EAF3FF;color:#1C1C1E}

QTableView, QTableWidget {background:white;border:0;gridline-color:transparent;outline:0;alternate-background-color:#FAFAFC;selection-background-color:#E5F1FF;selection-color:#1C1C1E}
QTableView::item, QTableWidget::item {padding:0 6px;border-bottom:1px solid #F0F0F3}
QTableView::item:hover, QTableWidget::item:hover {background:#F2F7FF}
QTableView::item:selected, QTableWidget::item:selected {background:#E5F1FF;color:#1C1C1E}
QHeaderView {background:white;border:0}
QHeaderView::section {background:white;color:#8E8E93;border:0;border-bottom:1px solid #E6E7EC;padding:8px 6px;font-size:12px;font-weight:600}
QTableCornerButton::section {background:white;border:0}

QScrollArea {background:transparent;border:0}
QScrollArea > QWidget > QWidget {background:transparent}
QScrollBar:vertical {background:transparent;width:8px;margin:3px 1px}
QScrollBar:horizontal {background:transparent;height:8px;margin:1px 3px}
QScrollBar::handle:vertical {background:rgba(142,142,147,80);border-radius:3px;min-height:32px}
QScrollBar::handle:horizontal {background:rgba(142,142,147,80);border-radius:3px;min-width:32px}
QScrollBar::handle:hover {background:rgba(142,142,147,140)}
QScrollBar::add-line, QScrollBar::sub-line {width:0;height:0}
QScrollBar::add-page, QScrollBar::sub-page {background:none}
QSplitter::handle {background:transparent}

QToolTip {background:#2C2C2E;color:white;border:0;border-radius:6px;padding:6px 8px}
QLabel#toast {background:rgba(28,28,30,232);color:white;border-radius:17px;padding:8px 20px;font-weight:500}
QDialog {background:#F3F4F8}

QPushButton#tile {background:#F7F7FA;border:1px solid #E6E7EC;color:#1C1C1E;border-radius:12px;padding:11px 14px;font-weight:500}
QPushButton#tile:hover {background:#E5F0FF;border-color:#B8D6FF;color:#007AFF}
QPushButton#tile:pressed {background:#007AFF;border-color:#0A6FE0;color:white}
QPushButton#tile:disabled {color:#B0B0B5;background:#F2F2F5}
QPushButton#pad {background:#F7F7FA;border:1px solid #E6E7EC;color:#1C1C1E;border-radius:14px;font-size:18px;font-weight:600;padding:0}
QPushButton#pad:hover {background:#E5F0FF;border-color:#B8D6FF;color:#007AFF}
QPushButton#pad:pressed {background:#007AFF;border-color:#0A6FE0;color:white}
QPushButton#pad:disabled {color:#B0B0B5;background:#F2F2F5}
QPushButton#padStop {background:#FFE9E8;border:1px solid #FFD0CC;color:#FF3B30;border-radius:14px;font-weight:700;padding:0}
QPushButton#padStop:pressed {background:#FF3B30;color:white}
QSlider::groove:horizontal {height:4px;background:#E1E2E8;border-radius:2px}
QSlider::sub-page:horizontal {background:#007AFF;border-radius:2px}
QSlider::handle:horizontal {background:white;border:1px solid #D1D1D6;width:22px;height:22px;margin:-9px 0;border-radius:11px}
QFrame#stat {background:#F7F7FA;border:1px solid #E6E7EC;border-radius:14px}
QLabel#statValue {font-size:18px;font-weight:700}
QLabel#deviceName {font-size:14px;font-weight:700}
QLabel#badge {background:#E1EEFF;color:#007AFF;border-radius:9px;padding:1px 8px;font-size:11px;font-weight:700}
QPushButton#filterChip {background:#F2F2F5;border:1px solid #E6E7EC;border-radius:13px;padding:3px 10px;color:#545458;font-size:12px;font-weight:600}
QPushButton#filterChip:hover {color:#007AFF;background:#E5F0FF}
QPushButton#filterChip:checked {background:#007AFF;border-color:#007AFF;color:white}
QPushButton#chip {background:#E5F1FF;border:0;color:#007AFF;border-radius:13px;padding:4px 12px;font-weight:600}
QPushButton#chip:hover {background:#D6E8FF}
QProgressBar {background:#E6E7EC;border:0;border-radius:3px}
QProgressBar::chunk {background:#007AFF;border-radius:3px}
QFrame#noteCard {background:#FFF8E6;border:1px solid #FFE2A8;border-radius:14px}
QFrame#banner {background:#EEF5FF;border:1px solid #CFE2FF;border-radius:14px}
QFrame#banner[error="true"] {background:#FFF0EF;border:1px solid #FFD0CC}
QMenu {background:white;border:1px solid #E1E2E8;border-radius:12px;padding:6px}
QMenu::item {padding:7px 18px;border-radius:8px;color:#1C1C1E}
QMenu::item:selected {background:#007AFF;color:white}
QPushButton#primary::menu-indicator {image:none;width:0}
QLabel#detailBlock {background:#F7F7FA;border-radius:12px;padding:10px}
